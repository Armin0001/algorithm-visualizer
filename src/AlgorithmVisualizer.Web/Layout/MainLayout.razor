@inherits LayoutComponentBase

<div class="shell">
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" href="">
                <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2" y="13" width="4" height="9" rx="1" />
                    <rect x="7" y="8" width="4" height="14" rx="1" />
                    <rect x="12" y="15" width="4" height="7" rx="1" class="accent" />
                    <rect x="17" y="3" width="4" height="19" rx="1" />
                </svg>
                <span>Algorithm Visualizer</span>
            </a>
            <nav class="tabs" aria-label="Sections">
                <NavLink href="" Match="NavLinkMatch.All">Sorting</NavLink>
                <NavLink href="search">Searching</NavLink>
            </nav>
            <a class="source-link" href="https://github.com/Armin0001/algorithm-visualizer" target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
                <span>Source</span>
            </a>
        </div>
    </header>

    <main class="container">
        @Body
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>
                Built in C# with .NET 10 and Blazor WebAssembly, so the algorithms run in your browser.
                Every frame is replayed from steps recorded by the same code the unit tests run.
                <a href="https://github.com/Armin0001/algorithm-visualizer" target="_blank" rel="noopener">Source, tests and design notes on GitHub</a>.
            </p>
        </div>
    </footer>
</div>
